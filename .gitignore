# --- Python ---
__pycache__/
*.pyc

# --- Large databases and downloaded tools (re-download; see README.md) ---
db/
bin/

# --- Raw downloads and large intermediates (rebuild with the step scripts) ---
data/mv/
data/phix/
data/phages/
data/*.zip
data/blastp_all.tsv
data/cluster_reps.fna
data/q_proteins.faa
data/q_vs_ref.tsv
data/phrog_hits.tsv
data/tblastn_phix.tsv
data/mm/
