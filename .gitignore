# --- Evo 2 working files that are large or rebuildable ---
evo2/checkv_ctrl/in.fna
evo2/checkv_ctrl/out/*
!evo2/checkv_ctrl/out/quality_summary.tsv
evo2/checkv_out/*
!evo2/checkv_out/quality_summary.tsv

# --- Friend's benchmark scoring: keep tables and sequences, not CheckV scratch ---
bench/checkv_full/*
!bench/checkv_full/quality_summary.tsv

# --- Raw run logs (contain local paths and Modal app links; costs are recorded in RUNLOG.md) ---
*.log
*.log.jsonl
evo2/*.log

# --- Phold large outputs (the per-gene tables are kept) ---
phold/out*/phold_prostT5_*
phold/out*/phold.gbk
phold/out*/sub_db_tophits/
phold/out*/phold_3di.fasta

